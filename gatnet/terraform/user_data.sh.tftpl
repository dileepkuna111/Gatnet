#!/bin/bash
set -euxo pipefail
dnf update -y
dnf install -y nodejs20 unzip awscli-2
mkdir -p /opt/gatnet
aws s3 cp "s3://${bucket}/${key}" /tmp/gatnet-app.zip --region "${region}"
unzip -o /tmp/gatnet-app.zip -d /opt/gatnet
cd /opt/gatnet
npm install --omit=dev
cat >/etc/systemd/system/gatnet.service <<'SERVICE'
[Unit]
Description=Gatnet Node.js demo website
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/gatnet
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/gatnet/server.js
Restart=always
RestartSec=5
User=ec2-user
Group=ec2-user
[Install]
WantedBy=multi-user.target
SERVICE
chown -R ec2-user:ec2-user /opt/gatnet
systemctl daemon-reload
systemctl enable --now gatnet
